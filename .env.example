# ==============================================================================
# Ambiente e Infraestrutura Local: WhatsApp AI Triage System
# ==============================================================================

# --- Configurações Gerais ---
TIMEZONE=America/Sao_Paulo

# --- n8n (Workflow Automation) ---
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=sua_chave_secreta_n8n_de_criptografia_aqui
N8N_SECURE_COOKIE=false
N8N_USER_FOLDER=/home/node/.n8n

# --- Evolution API (WhatsApp Gateway v2.x) ---
EVOLUTION_PORT=8080
EVOLUTION_API_KEY=sua_chave_global_da_evolution_api_aqui
EVOLUTION_SERVER_URL=http://localhost:8080

# --- Evolution API Configurações Internas ---
DATABASE_ENABLED=false
DATABASE_CONNECTION_URI=
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange

# Armazenamento em arquivos locais (JSON Store)
STORE_MESSAGES=true
STORE_MESSAGE_UP=true
STORE_CONTACTS=true
STORE_CHATS=true

# Webhook Global / Instância (apontando internamente para a rede Docker ou localhost)
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=http://n8n:5678/webhook/evolution

# --- Inteligência Artificial (Google Gemini) ---
GEMINI_API_KEY=sua_chave_gemini_api_aqui

# --- CRM / Google Sheets ---
# Credenciais ou IDs de planilha se aplicável via workflow
GOOGLE_SHEETS_SHEET_ID=
